# Template for the server-side .env used by docker-compose.prod.yml.
#
# Copy to the deploy directory on 192.168.20.141 as `.env`, fill every value,
# then `chmod 600 .env`. This file must never be committed with real values —
# it holds every credential the stack has.
#
# Generate each secret with:  openssl rand -hex 32

# ---------------------------------------------------------------- public URL
# The origin the app is served on. Used for CORS, for the Stripe redirect
# allowlist, and as the S3 endpoint that presigned recording URLs are signed
# against. No trailing slash.
PUBLIC_ORIGIN=https://imeet.itecknologi.com

# Browser-facing LiveKit signaling URL. Caddy proxies this path through to the
# LiveKit container (see Caddyfile.snippet); livekit-client appends /rtc itself.
LIVEKIT_PUBLIC_URL=wss://imeet.itecknologi.com/livekit

# ----------------------------------------------------------------- database
POSTGRES_USER=imeet
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
POSTGRES_DB=imeet

# --------------------------------------------------------------------- auth
# Must be at least 32 characters — the backend refuses to start otherwise.
# Changing this invalidates every existing session.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
# Optional: only needed for "Sign in with Google".
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------ LiveKit
# LIVEKIT_API_KEY is the key *name* and must match `webhook.api_key` in
# deploy/livekit.prod.yaml (default: imeet). The secret must NOT be the
# committed dev value — the backend checks for that at boot and refuses.
LIVEKIT_API_KEY=imeet
LIVEKIT_API_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ------------------------------------------------------- storage (MinIO/S3)
# Bucket name doubles as the public URL path Caddy routes to MinIO, so it must
# not collide with an app route (/login, /dashboard, /meeting, /videos).
S3_BUCKET=imeet-media
S3_REGION=us-east-1
MINIO_ROOT_USER=imeet-storage
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
# How long a recording download link stays valid.
S3_PRESIGN_TTL_SECONDS=3600
# Recordings are hard-deleted after this many days.
RECORDING_RETENTION_DAYS=30

# ----------------------------------------------------------- optional: AI
# Without these, transcription/summary/captions record a "failed" status
# instead of erroring visibly. Everything else works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------ optional: payments
# Without these, creating a paid meeting is rejected with a clear message.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
