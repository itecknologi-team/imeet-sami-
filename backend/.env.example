# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5442/videoapp
REDIS_URL=redis://localhost:6389

# Auth
# Required, no default — generate with `openssl rand -hex 32` (or the
# node equivalent: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated origins allowed to call the API/socket server. Leave unset
# in development (any origin is reflected, needed for LAN-IP testing); a
# production deploy must set this or the server refuses to start.
# ALLOWED_ORIGINS=https://app.example.com

# LiveKit (self-hosted via docker-compose)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=54ff5680291ef292eed976456cbcb409bc59e4f46ded592ba33f2c5a0eafdd19

# Storage (self-hosted MinIO via docker-compose)
S3_BUCKET=recordings
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# AI (Phase 5 - transcription + summary)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
