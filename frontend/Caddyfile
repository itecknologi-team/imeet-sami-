# Static file server for the built SPA, inside the frontend container. Public
# TLS, the imeet.itecknologi.com hostname and the /api + /socket.io routing all
# live in the *host's* Caddyfile (see deploy/Caddyfile.snippet) — this one only
# serves files on the internal network.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv

	encode zstd gzip

	# Fingerprinted build assets are safe to cache indefinitely; index.html must
	# never be cached or browsers keep booting an old bundle after a deploy.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# Client-side routing: every unknown path is an app route, not a 404.
	try_files {path} /index.html
	file_server
}
